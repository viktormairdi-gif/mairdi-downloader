{
  "manifest_version": 3,
  "name": "MAIRDI Загрузчик",
  "version": "1.2.0",
  "description": "Перехватывает загрузки браузера и скачивает видео через MAIRDI Загрузчик — быстро, с докачкой и раскладкой по папкам.",
  "key": "",
  "permissions": ["downloads", "contextMenus", "nativeMessaging", "cookies", "storage", "tabs", "notifications", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "MAIRDI Загрузчик",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
